// Pre-Baked Global Niri Wayland Configuration
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        click-method "clickfinger"
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#414868"
    }
}

// Automatically fire up essentials on user login
spawn-at-startup "waybar"
spawn-at-startup "lxqt-policykit-agent"
spawn-at-startup "swaybg" "-m" "solid" "-c" "#1a1b26"

binds {
    // Core Terminal & Launcher Triggers
    Mod+T { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    
    // Infinite Scrollable Columns Navigation
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    
    // Move Window Column Positions
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    
    // Safe Desktop Exit
    Mod+Shift+E { quit; }
}
